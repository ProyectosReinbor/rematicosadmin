generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  PENDIENTE
  VERIFICADA
  DISCREPANCIA
  RECHAZADA
}

enum VerificationMethod {
  MANUAL
}

enum UserRole {
  ADMIN
  USER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNAVAILABLE
  ARCHIVED
}

model Payment {
  id            String   @id @default(uuid())
  payerName     String   @map("payer_name")
  amount        Decimal  @db.Decimal(12, 2)
  bank          String
  reference     String   @unique
  status        String   @default("PENDING")
  paymentMethod String   @default("QR_BREB") @map("payment_method")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("payments")
  @@index([status])
  @@index([createdAt])
  @@index([reference])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("settings")
}

model AdImage {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  originalUrl    String   @map("original_url")
  noBgUrl        String?  @map("no_bg_url")
  finalUrl       String?  @map("final_url")
  productType    String?  @map("product_type")
  colors         Json?
  category       String?
  prompt         String?
  textStyle      String?  @map("text_style")
  template       String?
  provider       String?
  generationTime Int?     @map("generation_time")
  cost           Decimal? @db.Decimal(10, 6)
  metadata       Json     @default("{}")
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ad_images")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaymentVerification {
  id              String             @id @default(uuid())
  orderNumber     String             @map("order_number")
  customerName    String             @map("customer_name")
  expectedAmount  Decimal            @db.Decimal(12, 2) @map("expected_amount")
  expectedDate    DateTime?          @map("expected_date")
  receivedAmount  Decimal?           @db.Decimal(12, 2) @map("received_amount")
  receivedDate    DateTime?          @map("received_date")
  transactionRef  String?            @map("transaction_ref")
  notes           String?
  status          VerificationStatus @default(PENDIENTE)
  verificationMethod VerificationMethod @default(MANUAL) @map("verification_method")
  comparisonNotes String?            @map("comparison_notes")
  verifiedAt      DateTime?          @map("verified_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@map("payment_verifications")
  @@index([orderNumber])
  @@index([customerName])
  @@index([status])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("categories")
  @@index([isActive, sortOrder])
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String
  details     String?
  unit        String        @default("UNIDAD")
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  categoryId  String        @map("category_id")
  category    Category      @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("products")
  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
  @@index([productId, sortOrder])
}

model ProductOption {
  id        String        @id @default(uuid())
  productId String        @map("product_id")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    OptionValue[]
  sortOrder Int           @default(0) @map("sort_order")

  @@map("product_options")
  @@index([productId, sortOrder])
}

model OptionValue {
  id       String        @id @default(uuid())
  optionId String        @map("option_id")
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String

  @@map("option_values")
  @@unique([optionId, value])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reference   String?  @map("reference")
  attributes  Json     @default("{}")
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("product_variants")
  @@index([productId, isAvailable])
}
