# ─── DATABASE ────────────────────────────────
DATABASE_URL="postgresql://rematicos:rematicos@localhost:5432/rematicos"
DATABASE_URL_TEST="postgresql://rematicos:rematicos@localhost:5432/rematicos_test"

# ─── REDIS ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AUTH ────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-in-production-min-32-characters"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── SERVER ──────────────────────────────────
API_PORT="4000"
WEB_PORT="3000"
STORE_PORT="3001"
WS_PORT="4001"
NODE_ENV="development"
LOG_LEVEL="info"

# ─── DOMAINS ─────────────────────────────────
WEB_URL="https://rematicosadmin.reinbor.cloud"
STORE_URL="https://rematicos.reinbor.cloud"

# ─── TTS ─────────────────────────────────────
TTS_PROVIDER="openai"
OPENAI_API_KEY="sk-placeholder"
TTS_VOICE="alloy"
TTS_SPEED="1.0"
TTS_VOLUME="1.0"
TTS_LANGUAGE="es-CO"

# ─── BRE-B ───────────────────────────────────
BREB_ENABLED="false"
BREB_API_URL=""
BREB_API_KEY=""
BREB_POLLING_INTERVAL="60"

# ─── NOTIFICATIONS ───────────────────────────
NOTIFICATION_EMAIL_ENABLED="false"
NOTIFICATION_EMAIL_SMTP_HOST=""
NOTIFICATION_EMAIL_SMTP_PORT="587"
NOTIFICATION_EMAIL_FROM="noreply@rematicos.com"

# ─── WEBHOOKS ────────────────────────────────
WEBHOOK_SECRET="change-me-in-production"

# ─── BACKUP ──────────────────────────────────
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"